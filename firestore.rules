rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.language in ['ar', 'en'] &&
             data.notificationsEnabled is bool &&
             data.selectedLocation is string && data.selectedLocation.size() >= 1 && data.selectedLocation.size() <= 120 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCartItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.productId is string && isValidId(data.productId) &&
             data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 120 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.priceUsd is number && data.priceUsd >= 0 && data.priceUsd <= 100000 &&
             data.quantity is int && data.quantity >= 1 && data.quantity <= 99 &&
             data.rating is number && data.rating >= 0 && data.rating <= 5 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFavoriteItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.productId is string && isValidId(data.productId) &&
             data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 120 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidPharmacyOrder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.paymentMethod in ['mastercard', 'visa', 'cash'] &&
             data.subtotalUsd is number && data.subtotalUsd >= 0 && data.subtotalUsd <= 1000000 &&
             data.deliveryUsd is number && data.deliveryUsd >= 0 && data.deliveryUsd <= 10000 &&
             data.totalUsd is number && data.totalUsd >= 0 && data.totalUsd <= 1010000 &&
             data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 500 &&
             data.status in ['confirmed', 'preparing', 'delivering', 'delivered', 'cancelled'] &&
             data.deliveryLocation is string && data.deliveryLocation.size() >= 1 && data.deliveryLocation.size() <= 160 &&
             (!('cardLast4' in data) || (data.cardLast4 is string && data.cardLast4.size() <= 4)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRecentSearch(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.query is string && data.query.size() >= 1 && data.query.size() <= 80 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidChatMessage(data, pharmacyId) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.pharmacyId is string && data.pharmacyId == pharmacyId && isValidId(data.pharmacyId) &&
             data.senderType in ['USER', 'PHARMACY'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'language', 'notificationsEnabled', 'selectedLocation', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'language', 'notificationsEnabled', 'selectedLocation', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['language', 'notificationsEnabled', 'selectedLocation', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /cart/{productId} {
        allow get: if isOwner(userId) && isValidId(productId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(productId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().productId == productId &&
                         incoming().keys().hasAll(['userId', 'productId', 'productName', 'category', 'priceUsd', 'quantity', 'rating', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'productId', 'productName', 'category', 'priceUsd', 'quantity', 'rating', 'createdAt', 'updatedAt']) &&
                         isValidCartItem(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(productId) &&
                         isValidCartItem(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().productId == existing().productId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'priceUsd', 'productName', 'category', 'rating', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(productId);
      }

      match /favorites/{productId} {
        allow get: if isOwner(userId) && isValidId(productId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(productId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().productId == productId &&
                         incoming().keys().hasAll(['userId', 'productId', 'productName', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'productId', 'productName', 'createdAt']) &&
                         isValidFavoriteItem(incoming());

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(productId);
      }

      match /orders/{orderId} {
        allow get: if isOwner(userId) && isValidId(orderId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(orderId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().status == 'confirmed' &&
                         incoming().keys().hasAll(['userId', 'paymentMethod', 'subtotalUsd', 'deliveryUsd', 'totalUsd', 'itemCount', 'status', 'deliveryLocation', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'paymentMethod', 'subtotalUsd', 'deliveryUsd', 'totalUsd', 'itemCount', 'status', 'deliveryLocation', 'cardLast4', 'createdAt', 'updatedAt']) &&
                         isValidPharmacyOrder(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(orderId) &&
                         isValidPharmacyOrder(incoming()) &&
                         existing().status != 'delivered' &&
                         existing().status != 'cancelled' &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().paymentMethod == existing().paymentMethod &&
                         incoming().totalUsd == existing().totalUsd &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

        allow delete: if false;
      }

      match /recent_searches/{searchId} {
        allow get: if isOwner(userId) && isValidId(searchId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(searchId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'query', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'query', 'createdAt']) &&
                         isValidRecentSearch(incoming());

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(searchId);
      }

      match /chats/{pharmacyId}/messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(pharmacyId) && isValidId(messageId);
        allow list: if isOwner(userId) && isValidId(pharmacyId);

        allow create: if isOwner(userId) &&
                         isValidId(pharmacyId) &&
                         isValidId(messageId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'pharmacyId', 'senderType', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'pharmacyId', 'senderType', 'text', 'createdAt']) &&
                         isValidChatMessage(incoming(), pharmacyId);

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(pharmacyId) && isValidId(messageId);
      }
    }
  }
}
